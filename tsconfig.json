{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "web", "test"]
}
